{
  "name": "dsh-memtree",
  "version": "0.18.6",
  "type": "module",
  "description": "Long-term memory for DeepSeek Harness: MEMORY.md, daily notes the agent writes itself, nightly Auto Dream consolidation, hybrid BM25 + vector search with wikilink expansion, and a knowledge panel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rj-yejianping/dsh-memtree.git"
  },
  "homepage": "https://github.com/rj-yejianping/dsh-memtree#readme",
  "bugs": {
    "url": "https://github.com/rj-yejianping/dsh-memtree/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "memory",
    "long-term-memory",
    "agent-memory",
    "qwenpaw",
    "bm25",
    "rag"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "lint": "node --check index.js && node --check client.js && for f in src/*.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-tools": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": false
    },
    "@deepseek-ai/dsh-tools": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
